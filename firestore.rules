rules_version = '2';

// Each user can only read, create, update and delete their own documents:
// users/{uid}, users/{uid}/courses/{courseId} and users/{uid}/courses/{courseId}/tasks/{taskId}.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
